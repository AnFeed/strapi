{
  "kind": "collectionType",
  "collectionName": "catalog_categories",
  "info": {
    "singularName": "catalog-category",
    "pluralName": "catalog-categories",
    "displayName": "Product category",
    "description": "Categories for the new product catalog; the legacy Product collection is untouched."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "categoryCode": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "introduction": { "type": "richtext" },
    "seoTitle": { "type": "string" },
    "metaDescription": { "type": "text" },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::catalog-product.catalog-product",
      "mappedBy": "category"
    }
  }
}
