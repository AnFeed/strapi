{
  "kind": "collectionType",
  "collectionName": "catalog_products",
  "info": {
    "singularName": "catalog-product",
    "pluralName": "catalog-products",
    "displayName": "Catalog product",
    "description": "Individual bilingual feed products, identified by product code."
  },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "productCode": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::catalog-category.catalog-category",
      "inversedBy": "products"
    },
    "subcategory": { "type": "string" },
    "availability": {
      "type": "enumeration",
      "enum": ["in_store", "preorder"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "feedType": { "type": "string" },
    "lifeStage": { "type": "string" },
    "introduction": { "type": "text" },
    "forms": {
      "type": "component",
      "repeatable": true,
      "component": "catalog.form-variant"
    },
    "packages": {
      "type": "component",
      "repeatable": true,
      "component": "catalog.package-option",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "ingredients": { "type": "text" },
    "analyticalValues": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "benefits": { "type": "richtext" },
    "usage": { "type": "richtext" },
    "labelPdf": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["files"]
    },
    "labelFileName": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "relatedProductCodes": {
      "type": "text",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "seoTitle": { "type": "string" },
    "metaDescription": { "type": "text" }
  }
}
