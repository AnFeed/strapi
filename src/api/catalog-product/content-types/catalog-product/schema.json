{
  "kind": "collectionType",
  "collectionName": "catalog_products",
  "info": {
    "singularName": "catalog-product",
    "pluralName": "catalog-products",
    "displayName": "Catalog product",
    "description": "Individual bilingual catalog products, identified by product code."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "productCode": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::catalog-category.catalog-category",
      "inversedBy": "products",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "subcategory": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "availability": {
      "type": "enumeration",
      "enum": [
        "in_store",
        "preorder"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "feedType": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "lifeStage": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "introduction": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "imageAlt": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "forms": {
      "type": "component",
      "repeatable": true,
      "component": "catalog.form-variant",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "packages": {
      "type": "component",
      "repeatable": true,
      "component": "catalog.package-option",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "ingredients": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "analyticalValues": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "benefits": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "usage": {
      "type": "richtext",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "labelPdf": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "files"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "labelFileName": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "relatedProductCodes": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "seoTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "metaDescription": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
